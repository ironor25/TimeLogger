{
  "name": "pulsetime-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PulseTime - Workforce Time Tracking & Productivity SaaS Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @pulsetime/api --filter @pulsetime/web dev",
    "dev:api": "pnpm --filter @pulsetime/api dev",
    "dev:web": "pnpm --filter @pulsetime/web dev",
    "dev:desktop": "pnpm --filter pulsetime-desktop dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:seed": "ts-node ./prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:clean-live": "node ./scripts/clean-live-db.mjs",
    "mock-agent": "pnpm --filter @pulsetime/mock-agent start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "bcryptjs": "^2.4.3",
    "prettier": "^3.5.2",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcryptjs",
      "prisma",
      "msgpackr-extract",
      "esbuild"
    ]
  }
}
