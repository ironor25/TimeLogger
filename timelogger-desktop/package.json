{
  "name": "pulsetime-desktop",
  "version": "1.0.0",
  "description": "PulseTime - Workforce Desktop Time Tracker & Activity Monitor",
  "private": true,
  "author": "PulseTime Engineering",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "tsc && vite build && electron-packager . PulseTime --platform=win32 --arch=x64 --out=dist-package --overwrite --prune=false --ignore=\"^/(src|electron|release|dist-app|release-app|release-build|node_modules)\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.pulsetime.desktop",
    "productName": "PulseTime",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "dir",
      "executableName": "PulseTime",
      "sign": null,
      "signAndEditExecutable": false
    }
  }
}
